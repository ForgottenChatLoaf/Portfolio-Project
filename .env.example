# ============================================================
# Environment Configuration Template
# Portfolio of Ethan McClarence Gacud
# ============================================================
# Copy this file to .env for local overrides.
# In production on Render, set these as Environment Variables in the Render Dashboard.
# NEVER commit real credentials to GitHub.

# ------------------------------------------------------------
# 1. Local Environment (XAMPP Default)
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=root
DB_PASS=

# ------------------------------------------------------------
# 2. Production Environment (Render Web Service + Aiven MySQL)
# ------------------------------------------------------------
# CRITICAL NOTICE:
# The owner already has an Aiven MySQL service used by iCareDonate.
# Ensure the database name is set strictly to 'portfolio_db'.
# NEVER point DB_NAME to the iCareDonate database.
#
# DB_HOST=mysql-xxxx-xxxx.aivencloud.com
# DB_PORT=12345
# DB_NAME=portfolio_db
# DB_USER=avnadmin
# DB_PASS=your_aiven_password_here
# DB_SSL_CA=/path/to/ca.pem  # Or paste raw CA contents into Render environment variable

# ------------------------------------------------------------
# 3. Application Environment Settings
# ------------------------------------------------------------
APP_ENV=development
APP_DEBUG=false
